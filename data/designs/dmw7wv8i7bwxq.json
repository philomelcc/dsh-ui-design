  "summary": "细窄无箭头的淡色滚动条，悬停时颜色加深；不抢内容，但永远看得见。",
  "usage": "小面板、下拉列表、侧栏等带 overflow 的区域；内容会滚动但滚动不是主要操作的地方。",
  "caution": "整页长文档沿用系统滚动条更自然；需要精确控制滚动位置时再自绘（原生滚动条无法用 CSS 单独定位）。",
  "hint": "滚动列表看效果，鼠标移到右侧细条上会变深",
  "prompt": "【滚动条】目标：细窄、无上下箭头、淡色的自绘滚动条，滑过时颜色加深。用于小面板、下拉列表、侧栏等「会滚动但滚动不是主要操作」的区域。\n\n1) 结构：任何 `overflow:auto/scroll` 的容器都可以套用，直接把 `.scroll` 选择器换成目标容器的类名。\n\n2) 核心 CSS（webkit 伪元素，Chromium/Edge/Safari 通用）：\n```css\n::-webkit-scrollbar{width:12px;height:12px}\n::-webkit-scrollbar-button{display:none;width:0;height:0}\n::-webkit-scrollbar-track{background:transparent;margin:7px 0}\n::-webkit-scrollbar-thumb{background:color-mix(in srgb,var(--ui-text) 32%,transparent);border:3px solid transparent;border-right-width:4px;background-clip:padding-box;border-radius:999px}\n::-webkit-scrollbar-thumb:hover{background:color-mix(in srgb,var(--ui-text) 52%,transparent);background-clip:padding-box}\n::-webkit-scrollbar-thumb:active{background:color-mix(in srgb,var(--ui-text) 64%,transparent);background-clip:padding-box}\n::-webkit-scrollbar-corner{background:transparent}\n```\n\n3) **最大的坑**：只要写了 `scrollbar-width` / `scrollbar-color`，Chromium 就会整体忽略 `::-webkit-scrollbar` 伪元素，退回带箭头的系统滚动条。标准属性只能包在 `@supports not selector(::-webkit-scrollbar)` 里给 Firefox 兜底。\n\n4) 内缩：用「加宽滚动条 + 透明 border + background-clip:padding-box」把 thumb 做细，**不要**用 track 的 margin-right（不生效）。\n\n5) hover 加深要重复写 `background-clip`，否则 hover 时颜色会铺满整条。\n\n6) 演示（`!window.__uiInteractive` 时跑）：光标停在滚动条上 → 容器加 `.hot` 模拟 hover（伪元素没法被 JS 触发，所以要一个同款 `.hot::-webkit-scrollbar-thumb` 规则）→ 用 rAF 插值滚到底 → 再滚回顶部 → 光标隐藏。不要用 `scrollTo({behavior:'smooth'})`，没法控时长也测不到结束。\n\n7) 无障碍：滚动容器本身要能键盘聚焦（`tabindex=\"0\"` + `aria-label`），否则键盘用户滚不动；`prefers-reduced-motion` 下不跑演示。\n\n8) 使用场景：见 usage / caution。",
  "demoHtml": "<!doctype html>\n<html lang=\"zh\"><head><meta charset=\"utf-8\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0;min-height:100vh;font-family:\"Segoe UI\",system-ui,\"Microsoft YaHei\",sans-serif;color:var(--ui-text);background:var(--ui-bg);display:flex;align-items:center;justify-content:center;padding:18px}\n\n.panel{width:190px;height:130px;border-radius:11px;background:var(--ui-surface);background:color-mix(in srgb,var(--ui-text) 4%,var(--ui-bg));border:1px solid var(--ui-border);border-color:color-mix(in srgb,var(--ui-text) 12%,transparent);\n  overflow:auto;padding:6px}\n\n/* 自绘滚动条：细、无箭头、淡色，悬停加深。\n   只写 webkit 伪元素——同时写 scrollbar-width/color 会让 Chromium 整体忽略它们。\n   内缩用「加宽滚动条 + 透明 border + background-clip」，不要用 track 的 margin-right（不生效）。 */\n.panel::-webkit-scrollbar{width:12px;height:12px}\n.panel::-webkit-scrollbar-button{display:none;width:0;height:0}\n.panel::-webkit-scrollbar-track{background:transparent;margin:7px 0}\n.panel::-webkit-scrollbar-thumb{\n  background:color-mix(in srgb,var(--ui-text) 32%,transparent);\n  border:3px solid transparent;\n  border-right-width:4px;\n  background-clip:padding-box;\n  border-radius:999px}\n.panel::-webkit-scrollbar-thumb:hover,\n.panel.hot::-webkit-scrollbar-thumb{\n  background:color-mix(in srgb,var(--ui-text) 52%,transparent);\n  background-clip:padding-box}\n.panel::-webkit-scrollbar-thumb:active{\n  background:color-mix(in srgb,var(--ui-text) 64%,transparent);\n  background-clip:padding-box}\n.panel::-webkit-scrollbar-corner{background:transparent}\n\n/* Firefox 兜底：只有它不认 ::-webkit-scrollbar 时才给标准属性 */\n@supports not selector(::-webkit-scrollbar){\n  .panel{scrollbar-width:thin;scrollbar-color:var(--ui-text-dim) transparent}\n}\n\n.row{display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:7px;font-size:11px;\n  transition:background .13s ease}\n.row:hover{background:var(--ui-surface-2)}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--ui-brand);opacity:.7;flex:0 0 auto}\n.row span{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n\n@media (max-height:420px){\n  body{padding:10px}\n  .panel{width:170px;height:104px;padding:4px}\n  .row{font-size:10px;padding:5px 6px}\n  .panel::-webkit-scrollbar{width:10px}\n  .panel::-webkit-scrollbar-track{margin:5px 0}\n  .panel::-webkit-scrollbar-thumb{border-width:2px;border-right-width:3px}\n}\n@media (prefers-reduced-motion:reduce){\n  .row{transition:none}\n}\n</style></head>\n<body>\n\n<div class=\"panel\" id=\"panel\" tabindex=\"0\" aria-label=\"可滚动列表\">\n  <div class=\"row\"><i class=\"dot\"></i><span>设计稿 v1</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>设计稿 v2</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>设计稿 v3</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>动效规范</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>色彩方案</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>组件清单</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>图标资源</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>字体规范</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>间距系统</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>交互动效</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>响应式断点</span></div>\n  <div class=\"row\"><i class=\"dot\"></i><span>无障碍规范</span></div>\n</div>\n\n<script>\n(function(){\n  var panel = document.getElementById('panel');\n  var cursor = null, timers = [];\n\n  function clearTimers(){ timers.forEach(function(t){ clearTimeout(t); }); timers = []; }\n  function later(fn, ms){ timers.push(setTimeout(fn, ms)); }\n  function setHot(on){ panel.classList.toggle('hot', !!on); }\n\n  // 平滑滚动：用 rAF 插值，不要用 scrollTo({behavior:'smooth'})——那样没法控制时长、也测不到结束\n  function smoothTo(target, ms, done){\n    var start = panel.scrollTop, dist = target - start, t0 = 0;\n    function frame(now){\n      if(!t0) t0 = now;\n      var e = Math.min(1, (now - t0) / ms);\n      var k = e < .5 ? 2 * e * e : 1 - Math.pow(-2 * e + 2, 2) / 2;\n      panel.scrollTop = start + dist * k;\n      if(e < 1) requestAnimationFrame(frame);\n      else if(done) done();\n    }\n    requestAnimationFrame(frame);\n  }\n\n  function demo(){\n    if(!cursor && typeof window.__uiDemoCursor === 'function') cursor = window.__uiDemoCursor();\n    var r = panel.getBoundingClientRect();\n    if(!r.width || !r.height){ later(demo, 300); return; }\n    if(cursor && cursor.el) cursor.el.classList.add('show');\n    // 光标停在右侧滚动条上，模拟「悬停 → 滑块加深」\n    if(cursor && cursor.at) cursor.at(r.right - 7, r.top + 34);\n    setHot(true);\n    later(function(){\n      smoothTo(panel.scrollHeight - panel.clientHeight, 620);\n      later(function(){\n        setHot(false);\n        smoothTo(0, 520);\n        later(function(){\n          if(cursor && cursor.hide) cursor.hide();\n          later(demo, 1500);\n        }, 720);\n      }, 1500);\n    }, 460);\n  }\n\n  if(!window.__uiInteractive){\n    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if(!reduce) setTimeout(demo, 300);\n  }\n})();\n</script>\n</body></html>",
