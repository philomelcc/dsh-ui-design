  ],
  "summary": "列表条目悬停 0.4 秒后，在条目右侧浮出预览卡（图 + 标题 + 摘要），不遮挡列表；指针移开淡出。",
  "usage": "文件/图片/AI 产物的列表；需要「不点开先看一眼」的桌面端 hover 场景，条目 3–20 个。",
  "caution": "移动端没有 hover，改用点按预览；预览别超过一屏；行高 <24px 的密集列表容易误触，要把延迟加到 0.5 秒以上。",
  "hint": "悬停条目 0.4 秒，卡片在条目右侧浮出，不遮挡列表",
  "prompt": "【悬停预览】目标：列表/网格里的条目悬停 0.4 秒后，在**条目旁边**浮出一张预览卡（图 + 标题 + 摘要），移开淡出。用 rAF 跟指针的方案在窄视口会把列表压住，所以这里按「条目矩形」定位。\n\n1) 结构：.list > .item（缩略图 + 名称/元信息）、独立 .preview（fixed 定位，图 + 标题 + 摘要）。预览卡不占文档流。\n\n2) **定位策略（关键）**：`left = itemRect.right + 12`，`top = itemRect.top - 2`；右侧放不下（`left + w > innerWidth - 8`）就翻到条目左侧；再不行夹到视口内。**不要用指针坐标定位**——在 367px 宽的卡片里，指针右侧根本放不下 150px 的卡片，结果会直接盖住列表本身（用户反馈「卡片把条目全挡住了」）。\n\n3) 尺寸：预览卡 150px 宽、约 120px 高（图 84 + meta），够表达内容又不抢列表。列表宽 168、靠左放，给右侧留出预览空间。\n\n4) 防误触：`pointerenter` 后延迟 400ms 才显示；`pointerleave` 立即隐藏；列表项在预览显示时加 `.on` 高亮，让用户知道当前是哪条。\n\n5) 动画：opacity 0→1（0.18 秒）+ translateY(6px)→0（0.2 秒 cubic-bezier(.2,.8,.25,1)）。\n\n6) 无障碍：预览卡 aria-hidden 切换；预览内容是可选的装饰，不要让它抢占读屏焦点。\n\n7) 自动演示：只在 !window.__uiInteractive 时——光标移到第 2 条 → 预览出现 → 移到第 3 条 → 预览跟随换内容 → 隐藏 → 循环。弹窗里只保留真实悬停。\n\n8) 坑：窗口 resize 时要按当前条目重算位置；预览里别塞需要加载的图片（演示用 CSS 渐变画占位）；`prefers-reduced-motion` 下关掉过渡。\n\n9) 使用场景：文件/图片/文档列表需要「不跳页看略图」；条目特别密（行高 < 24px）或移动端长按场景改用别的方案。",
  "demoHtml": "<!doctype html>\n<html lang=\"zh\"><head><meta charset=\"utf-8\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0;min-height:100vh;font-family:\"Segoe UI\",system-ui,\"Microsoft YaHei\",sans-serif;color:var(--ui-text);background:var(--ui-bg);background:radial-gradient(720px 400px at 24% -12%,color-mix(in srgb,var(--ui-brand) 10%,transparent),transparent 62%),var(--ui-bg);display:flex;align-items:center;justify-content:flex-start;padding:22px 12px 22px 18px;overflow:hidden}\n.list{width:min(168px,100%);display:flex;flex-direction:column;gap:4px}\n.item{display:flex;align-items:center;gap:9px;height:30px;padding:0 8px;border-radius:8px;cursor:default;transition:background .14s ease}\n.item:hover,.item.on{background:color-mix(in srgb,var(--ui-text) 6%,transparent)}\n.thumb{flex:0 0 auto;width:22px;height:22px;border-radius:6px;overflow:hidden;background:linear-gradient(160deg,color-mix(in srgb,var(--ui-brand) 22%,var(--ui-surface)),color-mix(in srgb,var(--ui-brand) 8%,var(--ui-surface)))}\n.thumb.p2{background:linear-gradient(160deg,color-mix(in srgb,var(--ui-warn) 26%,var(--ui-surface)),color-mix(in srgb,var(--ui-warn) 8%,var(--ui-surface)))}\n.thumb.p3{background:linear-gradient(160deg,color-mix(in srgb,var(--ui-success) 24%,var(--ui-surface)),color-mix(in srgb,var(--ui-success) 8%,var(--ui-surface)))}\n.meta{min-width:0}\n.meta b{display:block;font-size:11.5px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.meta em{display:block;font-size:10px;color:var(--ui-text-dim);font-style:normal}\n/* 预览卡：位置由「条目矩形」决定（出现在条目右侧），不跟指针 —— 跟指针会压住列表本身 */\n.preview{position:fixed;left:0;top:0;width:150px;border-radius:12px;overflow:hidden;background:var(--ui-surface);background:color-mix(in srgb,var(--ui-text) 6%,var(--ui-bg));border:1px solid var(--ui-border);border-color:color-mix(in srgb,var(--ui-text) 16%,transparent);box-shadow:0 16px 40px color-mix(in srgb,var(--ui-text) 18%,transparent);opacity:0;transform:translateY(6px);pointer-events:none;transition:opacity .18s ease,transform .2s cubic-bezier(.2,.8,.25,1);z-index:20}\n.preview.on{opacity:1;transform:none}\n.pv-img{height:84px;background:\n  radial-gradient(circle at 74% 30%, color-mix(in srgb,var(--ui-brand) 62%,transparent) 0 9%, transparent 10%),\n  linear-gradient(160deg,color-mix(in srgb,var(--ui-brand) 16%,var(--ui-surface)),color-mix(in srgb,var(--ui-brand) 6%,var(--ui-surface)))}\n.pv-img::after{content:\"\";display:block;position:relative;top:40px;height:44px;background:color-mix(in srgb,var(--ui-brand) 34%,transparent);clip-path:polygon(0 100%,28% 40%,50% 66%,70% 26%,100% 100%)}\n.pv-meta{padding:7px 9px 8px}\n.pv-meta b{display:block;font-size:11.5px;font-weight:600}\n.pv-meta em{display:block;margin-top:2px;font-size:10px;color:var(--ui-text-dim);font-style:normal}\n@media (prefers-reduced-motion:reduce){\n  .item,.preview{transition:none}\n}\n@media (max-height:420px){\n  body{padding:8px 8px 8px 10px}\n  .list{width:150px}\n  .item{height:29px}\n  .preview{width:138px}\n  .pv-img{height:74px}\n  .pv-img::after{top:34px;height:40px}\n  .pv-meta{padding:6px 8px 7px}\n}\n</style></head>\n<body>\n<div class=\"list\" id=\"list\">\n  <div class=\"item\"><span class=\"thumb\"></span><div class=\"meta\"><b>山间日出</b><em>1280 × 832 · 2 天前</em></div></div>\n  <div class=\"item\"><span class=\"thumb p2\"></span><div class=\"meta\"><b>海岸清晨</b><em>1024 × 1024 · 5 天前</em></div></div>\n  <div class=\"item\"><span class=\"thumb p3\"></span><div class=\"meta\"><b>林间小径</b><em>1536 × 864 · 1 周前</em></div></div>\n</div>\n<div class=\"preview\" id=\"preview\" aria-hidden=\"true\">\n  <div class=\"pv-img\"></div>\n  <div class=\"pv-meta\"><b id=\"pvTitle\">山间日出</b><em id=\"pvSub\">AI 生成 · 1280 × 832</em></div>\n</div>\n<script>\n(function(){\n  var list=document.getElementById('list'),\n      preview=document.getElementById('preview'),\n      pvTitle=document.getElementById('pvTitle'),\n      pvSub=document.getElementById('pvSub');\n  var items=[].slice.call(list.children);\n  var showTimer=0, onItem=null, cursor=null, timer=0, demoOn=false, activeRow=null;\n\n  /* 预览卡挂在「条目的右侧」，垂直与条目顶部对齐；右侧不够就翻到左侧，再不行就夹到视口内。\n     不要用指针坐标定位——在窄视口里指针右侧放不下，卡片会直接压在列表上。 */\n  function place(rect){\n    var w=preview.offsetWidth||150, h=preview.offsetHeight||120;\n    var left=rect.right+12, top=rect.top-2;\n    if(left+w>window.innerWidth-8) left=rect.left-w-12;\n    if(left<8) left=window.innerWidth-w-8;\n    if(left<8) left=8;\n    if(top+h>window.innerHeight-8) top=window.innerHeight-h-8;\n    if(top<8) top=8;\n    preview.style.left=left+'px';\n    preview.style.top=top+'px';\n  }\n\n  function show(item){\n    var r=item.getBoundingClientRect();\n    if(!r.width||!r.height) return;\n    var b=item.querySelector('b').textContent;\n    var em=item.querySelector('em').textContent;\n    pvTitle.textContent=b;\n    pvSub.textContent='AI 生成 · '+em;\n    place(r);\n    preview.classList.add('on');\n    preview.setAttribute('aria-hidden','false');\n    if(onItem) onItem.classList.remove('on');\n    onItem=item;\n    item.classList.add('on');\n  }\n  function hide(){\n    if(showTimer){ clearTimeout(showTimer); showTimer=0; }\n    preview.classList.remove('on');\n    preview.setAttribute('aria-hidden','true');\n    if(onItem) onItem.classList.remove('on');\n    onItem=null;\n  }\n\n  items.forEach(function(item){\n    item.addEventListener('pointerenter',function(){\n      hide();\n      showTimer=setTimeout(function(){ show(item); },400);\n    });\n    item.addEventListener('pointerleave',function(){ hide(); });\n  });\n  window.addEventListener('resize',function(){ if(onItem) place(onItem.getBoundingClientRect()); });\n\n  function cycle(){\n    if(window.__uiInteractive) return;\n    hide();\n    var r=list.getBoundingClientRect();\n    if(!r.width||!r.height){ timer=setTimeout(cycle,300); return; }\n    if(!cursor&&typeof window.__uiDemoCursor==='function') cursor=window.__uiDemoCursor();\n    if(!cursor){ show(items[1]); timer=setTimeout(function(){ hide(); timer=setTimeout(cycle,900); },2200); return; }\n    if(cursor.el) cursor.el.classList.add('show');\n    demoOn=true;\n    cursor.moveTo(items[1]);\n    timer=setTimeout(function(){\n      show(items[1]);\n      timer=setTimeout(function(){\n        cursor.moveTo(items[2]);\n        show(items[2]);\n        timer=setTimeout(function(){\n          hide();\n          demoOn=false;\n          cursor.hide();\n          timer=setTimeout(cycle,900);\n        },1300);\n      },1500);\n    },520);\n  }\n\n  if(!window.__uiInteractive){ timer=setTimeout(cycle,400); }\n})();\n</script>\n</body></html>",
