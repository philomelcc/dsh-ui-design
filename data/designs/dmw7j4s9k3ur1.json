  "summary": "层级路径「首页 / 项目 / 文档 / 当前页」：前面的层级可点返回，最后一项是当前页不可点。",
  "usage": "层级 3 层以上、需要随时知道「我在哪、怎么回去」的详情页（后台、文档站、电商分类）。",
  "caution": "只有 1–2 层时不需要（顶部导航已经够）；路径超过 6 层要折叠中间项；不要用它代替返回按钮。",
  "hint": "点前面的层级可以回到那一层",
  "prompt": "【面包屑导航】目标：一条层级路径「首页 / 项目 / 文档 / 当前页」，前面的层级是链接、可点返回，最后一项是当前页（加深、不可点）；点击某一级时路径截断到那一级、标题跟着变。\n\n1) 结构：.crumb（flex、items-center、gap 6px、nowrap）里放 `a` 链接 + `.sep` 分隔符 + `.cur` 当前项；下方 .panel 是内容区。\n\n2) 样式：链接 color var(--ui-text-dim)，hover 变 var(--ui-brand) + 8% 品牌淡底 + 4px 圆角；分隔符用 color-mix(in srgb,var(--ui-text) 30%,transparent)；当前项 var(--ui-text) + font-weight 600。\n\n3) 交互：点第 i 级 → 路径只保留 0..i（截断！用 `PATH.slice(0, cur + 1)` 渲染），当前项 = 那一级，内容区标题同步更新。\n\n4) **前进入口（关键）**：面包屑只能「回」，返回上层后深层级被截掉，用户就再也进不去了。所以内容区必须给一个「进入「下一层」→」的按钮（cur < 最深时显示，最深时隐藏），点击 `go(cur + 1)` 前进。没有它，demo 点完「首页」就卡在浅层了。\n\n5) 无障碍：nav 加 aria-label=\"面包屑\"，当前项 aria-current=\"page\"；分隔符 aria-hidden=\"true\"。\n\n6) 坑：长路径要 nowrap + 最后一项 ellipsis；路径超过 6 层时中间用「…」折叠；卡片预览 176px 高时压缩字号与 padding，deeper 按钮也要缩小。\n\n7) 配色：只用 --ui-* 变量。\n\n8) 自动演示：只在 !window.__uiInteractive 时循环（从第 2 层开始，光标点「进入下一层」按钮 → 前进一层 → 停 1.5 秒 → 复位）；弹窗里只绑点击。\n\n9) 使用场景：3 层以上的详情页定位；1–2 层用顶部导航即可。写进 usage / caution。",
  "demoHtml": "<!doctype html>\n<html lang=\"zh\"><head><meta charset=\"utf-8\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0;min-height:100vh;font-family:\"Segoe UI\",system-ui,\"Microsoft YaHei\",sans-serif;color:var(--ui-text);background:var(--ui-bg);display:flex;flex-direction:column;justify-content:center;padding:24px}\n\n.crumb{display:flex;align-items:center;gap:5px;font-size:12px;flex-wrap:nowrap;overflow:hidden}\n.crumb a{color:var(--ui-text-dim);text-decoration:none;cursor:pointer;white-space:nowrap;border-radius:4px;padding:2px 4px;transition:color .15s ease,background .15s ease}\n.crumb a:hover{color:var(--ui-brand);background:color-mix(in srgb,var(--ui-brand) 8%,transparent)}\n.crumb .sep{flex:0 0 auto;color:color-mix(in srgb,var(--ui-text) 30%,transparent);font-size:11px}\n.crumb .cur{color:var(--ui-text);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}\n\n.panel{margin-top:12px;padding:14px;border-radius:12px;background:var(--ui-surface);border:1px solid var(--ui-border)}\n.panel h3{margin:0 0 6px;font-size:14px;color:var(--ui-text)}\n.panel p{margin:0;font-size:12px;line-height:1.6;color:var(--ui-text-dim)}\n\n/* 进入更深层级的入口：面包屑只能「回」，前进得靠页面内的入口 */\n.deeper{margin-top:10px;display:inline-flex;align-items:center;gap:5px;border:1px solid var(--ui-border);\n  background:var(--ui-surface-2);color:var(--ui-text);font:inherit;font-size:11px;font-weight:600;\n  padding:5px 10px;border-radius:7px;cursor:pointer;transition:border-color .15s ease,color .15s ease,background .15s ease}\n.deeper:hover{border-color:color-mix(in srgb,var(--ui-brand) 45%,var(--ui-border));color:var(--ui-brand);background:color-mix(in srgb,var(--ui-brand) 7%,var(--ui-surface-2))}\n.deeper:active{transform:scale(.97)}\n\n@media (max-height:420px){\n  body{padding:12px}\n  .crumb{font-size:11px;gap:4px}\n  .panel{margin-top:9px;padding:10px 11px}\n  .panel h3{font-size:13px}\n  .panel p{font-size:11px;line-height:1.55}\n  .deeper{margin-top:7px;font-size:10px;padding:4px 8px}\n}\n@media (prefers-reduced-motion:reduce){\n  .crumb a,.deeper{transition:none}\n}\n</style></head>\n<body>\n\n<nav class=\"crumb\" id=\"crumb\" aria-label=\"面包屑\"></nav>\n<div class=\"panel\">\n  <h3 id=\"pt\">API 参考</h3>\n  <p id=\"pd\">层级越深越需要面包屑：用户得知道自己在哪一层、怎么回去。点前面的层级会回到那一层。</p>\n  <button class=\"deeper\" id=\"deeper\" type=\"button\">进入「项目」→</button>\n</div>\n\n<script>\n(function(){\n  var crumb = document.getElementById('crumb'),\n      pt = document.getElementById('pt'),\n      pd = document.getElementById('pd'),\n      deeper = document.getElementById('deeper');\n\n  var PATH = ['首页', '项目', '文档', 'API 参考'];\n  var DESC = {\n    '首页': '回到首页，一切从这里开始。要往下走，用下面的入口。',\n    '项目': '项目层：聚合文档、成员与设置。面包屑只能回，前进靠页面内的入口。',\n    '文档': '文档层：按主题组织的手册与说明。',\n    'API 参考': '层级越深越需要面包屑：用户得知道自己在哪一层、怎么回去。'\n  };\n  var cur = PATH.length - 1;\n  var timer = null, cursor = null;\n\n  function render(){\n    crumb.innerHTML = '';\n    /* 只渲染到当前层级：返回上一层时，更深的层级要被截掉 */\n    PATH.slice(0, cur + 1).forEach(function(name, i){\n      if(i > 0){\n        var s = document.createElement('span');\n        s.className = 'sep';\n        s.setAttribute('aria-hidden', 'true');\n        s.textContent = '/';\n        crumb.appendChild(s);\n      }\n      if(i === cur){\n        var c = document.createElement('span');\n        c.className = 'cur';\n        c.setAttribute('aria-current', 'page');\n        c.textContent = name;\n        crumb.appendChild(c);\n      } else {\n        var a = document.createElement('a');\n        a.href = 'javascript:void(0)';\n        a.textContent = name;\n        a.setAttribute('data-i', i);\n        a.addEventListener('click', function(e){\n          e.preventDefault();\n          go(Number(this.getAttribute('data-i')));\n        });\n        crumb.appendChild(a);\n      }\n    });\n\n    pt.textContent = PATH[cur];\n    pd.textContent = DESC[PATH[cur]] || '';\n\n    /* 还能往下走时，内容区给一个前进入口 */\n    if(cur < PATH.length - 1){\n      deeper.style.display = '';\n      deeper.textContent = '进入「' + PATH[cur + 1] + '」→';\n    } else {\n      deeper.style.display = 'none';\n    }\n  }\n\n  function go(i){\n    cur = Math.max(0, Math.min(PATH.length - 1, i));\n    render();\n  }\n\n  function ensureCursor(){\n    if(cursor) return cursor;\n    if(!window.__uiInteractive && typeof window.__uiDemoCursor === 'function'){\n      cursor = window.__uiDemoCursor();\n    }\n    return cursor;\n  }\n\n  function demo(){\n    /* 每轮从第 2 层开始，演示「前进到下一层」 */\n    cur = 1;\n    render();\n\n    var c = ensureCursor();\n    if(!c) return;\n    if(c.el) c.el.classList.add('show');\n\n    var target = document.getElementById('deeper');\n    if(!target || target.style.display === 'none') return;\n    c.moveTo(target);\n    setTimeout(function(){\n      c.press();\n      setTimeout(function(){\n        c.release();\n        go(cur + 1);\n        if(c.hide) c.hide();\n      }, 190);\n    }, 560);\n  }\n\n  function start(){\n    stop();\n    setTimeout(function(){ demo(); timer = setInterval(demo, 4200); }, 400);\n  }\n  function stop(){ if(timer){ clearInterval(timer); timer = null; } }\n\n  deeper.addEventListener('click', function(){ go(cur + 1); });\n\n  window.addEventListener('resize', render);\n  render();\n  if(!window.__uiInteractive) start();\n})();\n</script>\n</body></html>",
